{
  "work_extensions": [
    {
      "name": "sre-sim",
      "config": {
        "tenant": "local",
        "refresh_every": "10s",
        "alert_every": "5s",
        "deployments": [
          {
            "ref": "deployment://prod/checkout",
            "image": "checkout:v2",
            "good_image": "checkout:v1",
            "bad_images": ["checkout:v2"]
          }
        ]
      }
    }
  ],
  "work": {
    "correlation_rules": [
      {
        "name": "high-error-rate",
        "match": {"event_types": ["alert.firing"], "where": {"field": "labels.alertname", "op": "eq", "value": "HighErrorRate"}},
        "key": "dedup_key",
        "window": "30m",
        "action": "create",
        "work_kind": "incident",
        "template": "auto-rollback",
        "title": "${label.alertname} on ${subject}",
        "intent": "mitigate",
        "priority": 50
      }
    ],
    "templates": [
      {
        "id": "auto-rollback",
        "version": 1,
        "kind": "incident",
        "limits": {"max_runs": 4, "max_replans": 1, "max_duration": "1h", "max_actions": 2},
        "stages": [
          {
            "id": "mitigate",
            "type": "action",
            "phase": "mitigate",
            "on_failure": "block",
            "on_timeout": "block",
            "action": {
              "name": "deployment.rollback",
              "target": "${subject}",
              "args": {"to_image": "checkout:v1"},
              "approval_timeout": "30m"
            }
          },
          {
            "id": "verify",
            "type": "verify",
            "phase": "verify",
            "on_failure": "block",
            "on_timeout": "block",
            "verify": {
              "recheck_every": "15s",
              "timeout": "10m",
              "spec": {
                "stable_for": "30s",
                "all_of": [
                  {
                    "id": "error_rate_below_1pct",
                    "kind": "metric",
                    "metric": {"source": "sim", "query": "error_rate", "aggregate": "max", "operator": "<", "threshold": 0.01},
                    "window": "45s",
                    "min_samples": 3
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "id": "investigate-and-rollback",
        "version": 1,
        "kind": "incident",
        "stages": [
          {"id": "investigate", "type": "run", "phase": "investigate",
           "run": {"goal": "Investigate \"${title}\" on ${subjects}. Collect evidence, rank hypotheses and propose one mitigation as proposed_action. Do not perform production writes."}},
          {"id": "mitigate", "type": "action", "phase": "mitigate",
           "action": {"from_proposal": "investigate", "allowed": ["deployment.rollback", "traffic.shift"]}},
          {"id": "verify", "type": "verify", "phase": "verify", "on_failure": "investigate",
           "verify": {"recheck_every": "15s", "timeout": "10m", "spec": {"stable_for": "30s", "all_of": [
             {"id": "error_rate_below_1pct", "kind": "metric", "window": "45s", "min_samples": 3,
              "metric": {"source": "sim", "query": "error_rate", "aggregate": "max", "operator": "<", "threshold": 0.01}}]}}},
          {"id": "review", "type": "run", "phase": "review", "on_failure": "skip",
           "run": {"goal": "Write a postmortem candidate for \"${title}\". Investigation summary: ${stage.investigate.summary}"}}
        ]
      }
    ]
  }
}
