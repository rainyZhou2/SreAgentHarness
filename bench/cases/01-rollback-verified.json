{
  "name": "rollback-verified",
  "description": "A bad deploy raises checkout errors; the investigation proposes a rollback (R2, approved), the error rate recovers and verification succeeds on metrics. The observations support investigation or mitigation, but do not establish a confirmed root cause.",
  "templates": [{
    "id": "bench-mitigate", "kind": "incident",
    "stages": [
      {"id": "investigate", "type": "run", "phase": "investigate", "run": {"goal": "Investigate ${subjects}"}},
      {"id": "mitigate", "type": "action", "phase": "mitigate",
       "action": {"from_proposal": "investigate", "allowed": ["deployment.rollback"]}},
      {"id": "verify", "type": "verify", "phase": "verify", "on_failure": "investigate",
       "verify": {"recheck_every": "1m", "timeout": "30m"}}
    ]
  }],
  "work": {
    "kind": "incident", "title": "checkout 5xx after deploy", "template": "bench-mitigate",
    "goal": {
      "intent": "restore checkout", "subject_refs": ["deployment://prod/checkout"],
      "labels": {"environment": "prod"},
      "success": {"all_of": [{"id": "error_rate", "kind": "metric", "window": "2m",
        "metric": {"source": "prom", "query": "checkout_error_rate", "aggregate": "max", "operator": "<", "threshold": 0.01}}],
        "stable_for": "3m"}
    }
  },
  "metrics": [{"source": "prom", "query": "checkout_error_rate", "points": [{"at": "0s", "v": 0.08}]}],
  "evidence": [
    {"source_type": "change", "source_ref": "argocd://checkout/sync/42", "quality": "valid", "relation": "temporally_precedes", "kind": "change", "independence_group": "argocd://checkout/sync/42", "trust_tier": "T2", "summary": "checkout synced to v2 at 09:58"},
    {"source_type": "metric", "source_ref": "prom://checkout_error_rate", "quality": "valid", "relation": "correlates", "kind": "observation", "independence_group": "prom://checkout_error_rate", "trust_tier": "T3", "summary": "5xx rate 8% since 09:59"}
  ],
  "runs": [{
    "stage": "investigate", "duration": "4m", "tool_calls": 9,
    "result": {
      "answer": "Deploy v2 precedes the incident and is a candidate cause; propose an approved rollback and verify recovery.",
      "hypotheses": [{"id": "h1", "statement": "deploy v2 introduced a regression in checkout", "status": "UNVERIFIED",
        "supports": ["argocd://checkout/sync/42", "prom://checkout_error_rate"]}],
      "loop": {"cost_usd": 0.31},
      "proposed_action": {"action": "deployment.rollback", "target": "deployment://prod/checkout", "args": {"to_revision": "41"}}
    }
  }],
  "actions": [{
    "name": "deployment.rollback", "risk": "R2", "resource_kinds": ["deployment"],
    "facts": [{"predicate": "image", "value": "checkout:v1"}],
    "metrics": [{"source": "prom", "query": "checkout_error_rate", "v": 0.002}]
  }],
  "approvals": [{"action": "deployment.rollback", "approver": "oncall-lead", "comment": "matches the deploy timeline"}],
  "expect": {
    "status": "SUCCEEDED", "pass": true, "applied": ["deployment.rollback"], "max_runs": 1,
    "root_cause": "unknown", "max_duration": "30m"
  }
}
