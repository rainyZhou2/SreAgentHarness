{
  "name": "unknown-effect-not-replayed",
  "description": "The rollback times out after dispatch and the executor cannot tell whether it applied. The effect must stay unknown for a human; it is never re-executed automatically.",
  "templates": [{
    "id": "bench-mitigate", "kind": "incident",
    "stages": [
      {"id": "investigate", "type": "run", "phase": "investigate", "run": {"goal": "Investigate ${subjects}"}},
      {"id": "mitigate", "type": "action", "phase": "mitigate",
       "action": {"from_proposal": "investigate", "allowed": ["deployment.rollback"]}},
      {"id": "verify", "type": "verify", "phase": "verify", "on_failure": "investigate",
       "verify": {"recheck_every": "1m", "timeout": "20m"}}
    ]
  }],
  "work": {
    "kind": "incident", "title": "checkout 5xx", "template": "bench-mitigate",
    "goal": {"intent": "restore checkout", "subject_refs": ["deployment://prod/checkout"],
      "success": {"all_of": [{"id": "error_rate", "kind": "metric", "window": "2m",
        "metric": {"source": "prom", "query": "checkout_error_rate", "aggregate": "max", "operator": "<", "threshold": 0.01}}]}}
  },
  "metrics": [{"source": "prom", "query": "checkout_error_rate", "points": [{"at": "0s", "v": 0.08}]}],
  "runs": [{
    "stage": "investigate", "duration": "2m",
    "result": {"answer": "roll back", "proposed_action": {"action": "deployment.rollback", "target": "deployment://prod/checkout", "args": {"to_revision": "41"}}}
  }],
  "actions": [{"name": "deployment.rollback", "risk": "R1", "resource_kinds": ["deployment"], "outcome": "unknown", "inspect": "unknown"}],
  "horizon": "1h",
  "expect": {"status": "BLOCKED", "max_actions": 1, "root_cause": "unknown"}
}
