  {
   "type": "stat",
   "title": "Effect unknown (now)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "expr": "sum(harness_action_backlog{state=~\"EFFECT_UNKNOWN|MANUAL_RECOVERY\"})",
     "refId": "A"
    }
   ],
   "id": 2
